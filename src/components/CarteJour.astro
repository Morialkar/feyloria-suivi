---
import { dateLongue, lien, type Jour } from '../lib/journal';

interface Props {
  jour: Jour;
  repli: string; // une pièce du jeu, quand le jour n'a pas encore son image
  vedette?: boolean;
}
const { jour, repli, vedette = false } = Astro.props;
const image = jour.image ? lien(jour.image) : lien(repli);
const actions = jour.fait.length;
---
<a class:list={['carte', 'jour', { vedette, 'holo-anim': vedette }]} href={lien(`jour/${jour.date}/`)}>
  <div class="visuel">
    <img src={image} alt="" loading={vedette ? 'eager' : 'lazy'} />
  </div>
  <div class="corps">
    <p class="date">{dateLongue(jour.date)}</p>
    <h3>{jour.titre}</h3>
    <p class="resume">{jour.resumeTexte}</p>
    <p class="chiffres">
      <span class="etiquette">{actions} réalisation{actions > 1 ? 's' : ''}</span>
      {jour.commits > 0 && <span class="etiquette">{jour.commits} commits</span>}
      {jour.commence.length > 0 && <span class="etiquette en-cours">{jour.commence.length} en cours</span>}
    </p>
  </div>
</a>

<style>
  .jour { display: grid; grid-template-columns: 180px 1fr; gap: 0; overflow: hidden; color: inherit; text-decoration: none; transition: transform 0.2s ease; }
  .jour:hover { transform: translateY(-4px); color: inherit; }
  .visuel { position: relative; min-height: 100%; }
  .visuel img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .visuel::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 55%, rgba(36, 14, 78, 0.9)); }
  .corps { padding: 22px 26px 22px 18px; }
  .date { margin: 0 0 4px; color: var(--beurre); font-weight: 800; font-size: 0.95em; }
  h3 { font-size: 1.45rem; margin-bottom: 8px; }
  .resume { margin: 0 0 14px; color: var(--doux); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .chiffres { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .en-cours { background: rgba(108, 232, 255, 0.16); color: var(--cyan); }
  .vedette { grid-template-columns: minmax(220px, 38%) 1fr; }
  .vedette h3 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .vedette .resume { -webkit-line-clamp: 6; font-size: 1.05em; }
  .vedette .corps { padding: 30px 34px 30px 22px; }
  @media (max-width: 640px) {
    .jour, .vedette { grid-template-columns: 1fr; }
    .visuel { height: 200px; }
    .visuel::after { background: linear-gradient(180deg, transparent 50%, rgba(36, 14, 78, 0.9)); }
    .corps, .vedette .corps { padding: 18px 20px 22px; }
  }
</style>
