---
import Base from '../layouts/Base.astro';
import { dateLongue, lien, lireJournal } from '../lib/journal';

// le fil : un jour après l'autre, du plus récent au plus ancien
const jours = lireJournal().reverse();
---
<Base titre="Feyloria · Journal de bord">
  <h1 class="sr-only">Journal de bord de Feyloria</h1>
  <ol class="fil">
    {jours.map((j) => (
      <li>
        <article aria-labelledby={`j-${j.date}`}>
          <h2 id={`j-${j.date}`} class="sr-only">{dateLongue(j.date)} : {j.titre}</h2>
          <a href={lien(`jour/${j.date}/`)} aria-label={`Voir le détail du ${dateLongue(j.date).toLowerCase()}`}>
            {j.image ? (
              <img src={lien(j.image)} alt="" width="1320" height="2200" loading="lazy" decoding="async" />
            ) : (
              <span class="sans-image">{dateLongue(j.date)}<br />{j.titre}</span>
            )}
          </a>
          <div class="sr-only">
            <p>{j.resumeTexte}</p>
            {j.fait.length > 0 && <ul>{j.fait.map((p) => <li set:html={p.html} />)}</ul>}
          </div>
        </article>
      </li>
    ))}
  </ol>
</Base>

<style>
  .fil { list-style: none; margin: 0 auto; padding: 0 16px; width: min(460px, 100%); display: grid; gap: 28px; }
  .fil a { display: block; border-radius: 26px; overflow: hidden; box-shadow: 0 18px 50px rgba(8, 0, 24, 0.55), 0 0 0 2px rgba(255, 255, 255, 0.12), 0 0 34px rgba(216, 122, 255, 0.3); transition: transform 0.2s ease; }
  .fil a:hover { transform: translateY(-3px); }
  .fil img { display: block; width: 100%; height: auto; }
  .sans-image { display: block; padding: 48px 24px; text-align: center; font-family: 'Bagel Fat One', sans-serif; font-size: 1.6rem; color: var(--texte); background: var(--carte); }
</style>
