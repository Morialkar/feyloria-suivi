---
import Base from '../layouts/Base.astro';
import CarteJour from '../components/CarteJour.astro';
import pieces from '../lib/pieces.json';
import { dateLongue, lien, lireJournal } from '../lib/journal';

const jours = lireJournal();
const recents = [...jours].reverse();
const dernier = recents[0];
const premier = jours[0];
const pieces6 = Object.keys(pieces).length;
const realisations = jours.reduce((n, j) => n + j.fait.length, 0);
const ids = Object.keys(pieces) as (keyof typeof pieces)[];
const repli = (i: number) => `img/pieces/${ids[i % ids.length]}.webp`;
---
<Base titre="Feyloria · Journal de bord">
  <section class="conteneur intro">
    <div class="texte">
      <span class="pilule-titre"><span class="etoile">✦</span> Journal de bord <span class="etoile">✦</span></span>
      <h1>Feyloria se construit, jour après jour</h1>
      <p class="chapeau">
        Un jeu mobile de décoration magique : chaque jour, des pièces nacrées à habiller de couleurs, de matières et de styles
        dessinés, à partager en duel. Ici, on raconte ce qui avance, depuis le premier commit du {dateLongue(premier.date).toLowerCase()}.
      </p>
      <div class="stats">
        <div class="stat carte"><strong>{jours.length}</strong><span>jours</span></div>
        <div class="stat carte"><strong>{realisations}</strong><span>nouveautés</span></div>
        <div class="stat carte"><strong>{pieces6}</strong><span>pièces à décorer</span></div>
      </div>
      <a class="bouton" href={lien(`jour/${dernier.date}/`)}>Voir le dernier jour ›</a>
    </div>
    <div class="vitrine" aria-hidden="true">
      {ids.slice(0, 3).map((id, i) => <img class={`p${i}`} src={lien(`img/pieces/${id}.webp`)} alt="" />)}
      <img class="aria" src={lien('img/aria_galaxy.webp')} alt="" />
    </div>
  </section>

  <section class="conteneur bloc">
    <h2 class="titre-section">La dernière journée</h2>
    <CarteJour jour={dernier} repli={repli(jours.length - 1)} vedette />
    {dernier.suivre.length > 0 && (
      <div class="carte prochaines">
        <h3>Prochaines étapes</h3>
        <ul>{dernier.suivre.map((p) => <li set:html={p.html} />)}</ul>
      </div>
    )}
  </section>

  <section class="conteneur bloc" id="jours">
    <h2 class="titre-section">Tous les jours</h2>
    <ol class="frise">
      {recents.map((j) => (
        <li>
          <CarteJour jour={j} repli={repli(jours.indexOf(j))} />
        </li>
      ))}
    </ol>
  </section>

  <section class="conteneur bloc">
    <h2 class="titre-section">Le Palais de Nacre</h2>
    <p class="muet">La première collection : six pièces blanches et nacrées, à décorer une par jour.</p>
    <div class="galerie">
      {ids.map((id) => (
        <figure class="carte">
          <img src={lien(`img/pieces/${id}.webp`)} alt={pieces[id]} loading="lazy" />
          <figcaption>{pieces[id]}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>

<style>
  .intro { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 40px; align-items: center; padding-block: 24px 48px; }
  .intro h1 { font-size: clamp(2.1rem, 5vw, 3.6rem); margin: 18px 0 14px; background: linear-gradient(90deg, #fff, #ffd6f5 40%, #c8f4ff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .chapeau { font-size: 1.15em; color: var(--doux); max-width: 38em; margin: 0 0 24px; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 26px; }
  .stat { padding: 16px 18px; }
  .stat strong { display: block; font-family: 'Bagel Fat One', sans-serif; font-weight: 400; font-size: 2rem; line-height: 1; color: var(--texte); }
  .stat span { display: block; overflow-wrap: anywhere; color: var(--discret); font-weight: 700; font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.04em; }
  .vitrine { position: relative; height: 460px; }
  .vitrine img { position: absolute; width: 46%; border-radius: 24px; box-shadow: var(--ombre), 0 0 0 3px rgba(255, 255, 255, 0.15), 0 0 40px rgba(216, 122, 255, 0.4); }
  .vitrine .p0 { left: 2%; top: 40px; transform: rotate(-7deg); }
  .vitrine .p1 { left: 28%; top: 0; z-index: 2; }
  .vitrine .p2 { right: 2%; top: 50px; transform: rotate(7deg); }
  .vitrine .aria { width: 34%; left: 33%; bottom: -10px; top: auto; z-index: 3; border-radius: 50%; box-shadow: 0 0 40px rgba(255, 90, 224, 0.6); }
  .bloc { padding-block: 28px; }
  .titre-section { font-size: clamp(1.6rem, 3vw, 2.1rem); margin-bottom: 18px; }
  .prochaines { margin-top: 18px; padding: 22px 28px; }
  .prochaines h3 { font-size: 1.3rem; margin-bottom: 8px; color: var(--beurre); }
  .prochaines ul { margin: 0; padding-left: 1.1em; color: var(--doux); }
  .prochaines li { margin-block: 6px; }
  .frise { list-style: none; margin: 0; padding: 0 0 0 28px; display: grid; gap: 18px; border-left: 3px solid; border-image: var(--holo) 1; }
  .frise li { position: relative; }
  .frise li::before { content: ''; position: absolute; left: -40px; top: 34px; width: 18px; height: 18px; border-radius: 50%; background: var(--verre); box-shadow: 0 0 16px var(--magenta); }
  .galerie { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; margin-top: 18px; }
  .galerie figure { margin: 0; overflow: hidden; }
  .galerie img { display: block; width: 100%; aspect-ratio: 3 / 4.4; object-fit: cover; border-radius: var(--rayon) var(--rayon) 0 0; }
  .galerie figcaption { padding: 10px 14px 14px; font-family: 'Kavoon', serif; font-size: 0.95em; text-align: center; }
  @media (max-width: 860px) {
    .intro { grid-template-columns: minmax(0, 1fr); }
    .vitrine { height: 340px; max-width: 460px; margin-inline: auto; width: 100%; }
  }
  @media (max-width: 520px) {
    .stats { gap: 8px; }
    .stat { padding: 12px; }
    .stat span { font-size: 0.7em; letter-spacing: 0; }
    .stat strong { font-size: 1.5rem; }
    .frise { padding-left: 18px; }
    .frise li::before { left: -28px; width: 14px; height: 14px; }
  }
</style>
