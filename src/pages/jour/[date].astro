---
import Base from '../../layouts/Base.astro';
import { dateCourte, dateLongue, lien, lireJournal, type Jour } from '../../lib/journal';

export function getStaticPaths() {
  const jours = lireJournal();
  return jours.map((jour, i) => ({ params: { date: jour.date }, props: { jour, avant: jours[i - 1], apres: jours[i + 1] } }));
}

interface Props {
  jour: Jour;
  avant?: Jour;
  apres?: Jour;
}
const { jour, avant, apres } = Astro.props;
const blocs = [
  { titre: 'Fait', puces: jour.fait },
  { titre: 'Commencé', puces: jour.commence },
  { titre: 'À suivre', puces: jour.suivre },
].filter((b) => b.puces.length > 0);
---
<Base titre={`${dateLongue(jour.date)} · Feyloria`} description={jour.resumeTexte}>
  <article class="jour">
    {jour.image && <img class="affiche" src={lien(jour.image)} alt="" width="1320" height="2200" />}
    <h1>{dateLongue(jour.date)}</h1>
    <p class="titre">{jour.titre}</p>
    <div class="resume" set:html={jour.resumeHtml} />
    {blocs.map((b) => (
      <section>
        <h2>{b.titre}</h2>
        <ul>{b.puces.map((p) => <li set:html={p.html} />)}</ul>
      </section>
    ))}
    <nav aria-label="Autres jours">
      {apres ? <a href={lien(`jour/${apres.date}/`)} aria-label={`Jour suivant : ${dateLongue(apres.date).toLowerCase()}`}>‹ {dateCourte(apres.date)}</a> : <span />}
      <a href={lien('/')}>Tous les jours</a>
      {avant ? <a href={lien(`jour/${avant.date}/`)} aria-label={`Jour précédent : ${dateLongue(avant.date).toLowerCase()}`}>{dateCourte(avant.date)} ›</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .jour { width: min(560px, 100% - 32px); margin: 0 auto; }
  .affiche { display: block; width: min(460px, 100%); height: auto; margin: 0 auto 28px; border-radius: 26px; box-shadow: 0 18px 50px rgba(8, 0, 24, 0.55), 0 0 0 2px rgba(255, 255, 255, 0.12), 0 0 34px rgba(216, 122, 255, 0.3); }
  h1 { font-family: 'Bagel Fat One', sans-serif; font-weight: 400; font-size: 2rem; line-height: 1.15; margin: 0 0 4px; color: var(--beurre); }
  .titre { font-size: 1.3rem; font-weight: 800; margin: 0 0 10px; }
  .resume { color: var(--doux); }
  .resume :global(p) { margin: 0 0 10px; }
  h2 { font-size: 1.1rem; margin: 22px 0 6px; color: var(--beurre); }
  ul { margin: 0; padding-left: 1.2em; }
  li { margin: 4px 0; }
  nav { display: flex; justify-content: space-between; gap: 12px; margin-top: 36px; font-weight: 700; }
</style>
