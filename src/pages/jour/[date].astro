---
import Base from '../../layouts/Base.astro';
import pieces from '../../lib/pieces.json';
import { dateLongue, dateCourte, lien, lireJournal, type Jour, type Puce } from '../../lib/journal';

export function getStaticPaths() {
  const jours = lireJournal();
  return jours.map((jour, i) => ({ params: { date: jour.date }, props: { jour, avant: jours[i - 1], apres: jours[i + 1], rang: i } }));
}

interface Props {
  jour: Jour;
  avant?: Jour;
  apres?: Jour;
  rang: number;
}
const { jour, avant, apres, rang } = Astro.props;
const ids = Object.keys(pieces);
const piece = lien(`img/pieces/${ids[rang % ids.length]}.webp`);
const affiche = jour.image ? lien(jour.image) : undefined; // l'image du jour, montrée entière
const blocs: { titre: string; puces: Puce[]; classe: string }[] = [
  { titre: 'Fait', puces: jour.fait, classe: 'fait' },
  { titre: 'Commencé', puces: jour.commence, classe: 'commence' },
  { titre: 'À suivre', puces: jour.suivre, classe: 'suivre' },
].filter((b) => b.puces.length > 0);
---
<Base titre={`${jour.titre} · Feyloria, ${dateCourte(jour.date)}`} description={jour.resumeTexte}>
  <article class="conteneur">
    <header class:list={['carte', 'tete', 'holo-anim', { 'avec-affiche': affiche }]}>
      <img class="fond" src={piece} alt="" />
      {affiche && (
        <a class="affiche" href={affiche} aria-label="Voir l'image du jour en grand">
          <img src={affiche} alt={`${dateLongue(jour.date)} : ${jour.titre}`} />
        </a>
      )}
      <div class="contenu">
        <p class="jour-n">{dateLongue(jour.date)}</p>
        <h1>{jour.titre}</h1>
        <div class="resume" set:html={jour.resumeHtml} />
        <p class="chiffres">
          <span class="etiquette">{jour.fait.length} nouveautés</span>
        </p>
      </div>
    </header>

    {blocs.map((b) => (
      <section class={`bloc ${b.classe}`}>
        <h2><span class="pilule-titre">{b.titre}</span></h2>
        <ol class="liste">
          {b.puces.map((p) => (
            <li class="carte">
              {p.heure && <time>{p.heure}</time>}
              <span set:html={p.html} />
            </li>
          ))}
        </ol>
      </section>
    ))}

    <nav class="suite">
      {avant ? <a class="bouton or" href={lien(`jour/${avant.date}/`)}>‹ {dateCourte(avant.date)}</a> : <span />}
      <a href={lien('/#jours')}>Tous les jours</a>
      {apres ? <a class="bouton" href={lien(`jour/${apres.date}/`)}>{dateCourte(apres.date)} ›</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .tete { overflow: hidden; margin-block: 12px 36px; min-height: 340px; display: flex; align-items: flex-end; }
  .fond { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; border-radius: inherit; opacity: 0.55; }
  .tete::after { background: linear-gradient(180deg, rgba(18, 8, 44, 0.1), rgba(18, 8, 44, 0.92) 70%); inset: 0; height: auto; border-radius: inherit; }
  .contenu { position: relative; z-index: 1; padding: 120px 36px 32px; max-width: 52em; }
  .avec-affiche { display: grid; grid-template-columns: minmax(200px, 300px) 1fr; align-items: center; gap: 8px; }
  .avec-affiche .contenu { padding: 32px 36px 32px 8px; }
  .affiche { position: relative; z-index: 1; display: block; margin: 24px; border-radius: 22px; overflow: hidden; box-shadow: var(--ombre), 0 0 0 3px rgba(255, 255, 255, 0.18), 0 0 36px rgba(255, 90, 224, 0.45); transition: transform 0.2s ease; }
  .affiche:hover { transform: scale(1.02); }
  .affiche img { display: block; width: 100%; height: auto; }
  .jour-n { margin: 0 0 6px; color: var(--beurre); font-weight: 800; }
  
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin-bottom: 14px; }
  .resume { color: var(--doux); font-size: 1.08em; }
  .resume :global(p) { margin: 0 0 10px; }
  .resume :global(ul) { margin: 0 0 10px; padding-left: 1.2em; }
  .chiffres { display: flex; gap: 8px; flex-wrap: wrap; margin: 14px 0 0; }
  .bloc { margin-bottom: 36px; }
  .bloc h2 { font-size: 1.5rem; margin-bottom: 16px; }
  .liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .liste li { display: flex; gap: 14px; align-items: baseline; padding: 14px 20px; --rayon: 18px; }
  .liste li :global(code) { font-size: 0.85em; background: rgba(255, 255, 255, 0.1); padding: 0.05em 0.35em; border-radius: 6px; }
  time { flex: none; font-weight: 800; color: var(--cyan); font-variant-numeric: tabular-nums; min-width: 3.2em; }
  .commence time { color: var(--magenta); }
  .suivre h2 .pilule-titre { color: var(--beurre); }
  .suite { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 12px 24px; }
  .suite > a:nth-child(2) { color: var(--doux); font-weight: 700; }
  @media (max-width: 720px) {
    .avec-affiche { grid-template-columns: 1fr; }
    .affiche { margin: 20px auto 0; width: min(78%, 320px); }
    .avec-affiche .contenu { padding: 18px 20px 22px; }
  }
  @media (max-width: 560px) {
    .contenu { padding: 90px 20px 22px; }
    .liste li { flex-direction: column; gap: 2px; padding: 12px 16px; }
  }
</style>
