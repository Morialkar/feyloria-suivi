---
import '../styles/global.css';
import { lien } from '../lib/journal';

interface Props {
  titre: string;
  description?: string;
}
const { titre, description = 'Le journal de bord de Feyloria, jour après jour.' } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#12082c" />
    <link rel="icon" href={lien('img/aria_galaxy.webp')} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main { padding: 24px 0 56px; }
</style>
